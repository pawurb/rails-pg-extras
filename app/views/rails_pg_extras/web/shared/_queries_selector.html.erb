<%
  query_options = @all_queries.map do |query_name, meta|
    {
      label: query_name.to_s,
      value: query_name.to_s,
      disabled: meta[:disabled],
    }
  end
  selected_query = params[:query_name].presence
  selected_label = selected_query || "diagnose"
%>

<%= form_tag queries_path, id: "queries", method: :get, class: "mb-2" do %>
  <div class="pg-extras-combobox relative max-w-xl" data-pg-extras-combobox>
    <label for="pg-extras-query-search" class="block text-sm font-semibold text-gray-700 mb-1">Query</label>

    <div class="relative">
      <input
        type="text"
        id="pg-extras-query-search"
        class="border border-gray-400 rounded-lg p-2 pr-10 font-bold w-full bg-white focus:outline-none focus:ring-2 focus:ring-blue-400"
        value="<%= selected_label %>"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="pg-extras-query-list"
        aria-autocomplete="list"
        data-pg-extras-combobox-input
      />
      <button
        type="button"
        class="absolute inset-y-0 right-0 px-3 text-gray-500 hover:text-gray-800"
        aria-label="Toggle query list"
        data-pg-extras-combobox-toggle
        tabindex="-1"
      >▾</button>
    </div>

    <%= hidden_field_tag :query_name, selected_query, data: { pg_extras_combobox_value: true } %>
    <%= hidden_field_tag :db_key, params[:db_key] if params[:db_key].present? %>

    <ul
      id="pg-extras-query-list"
      class="absolute z-20 mt-1 w-full max-h-72 overflow-y-auto rounded-lg border border-gray-300 bg-white shadow-md hidden"
      role="listbox"
      data-pg-extras-combobox-list
    >
      <li
        class="px-3 py-2 cursor-pointer hover:bg-blue-50 <%= "bg-blue-100 font-semibold" if selected_query.blank? %>"
        role="option"
        data-value=""
        data-label="diagnose"
        data-pg-extras-combobox-option
      >diagnose</li>

      <% query_options.each do |option| %>
        <li
          class="px-3 py-2 <%= option[:disabled] ? "text-gray-400 cursor-not-allowed" : "cursor-pointer hover:bg-blue-50" %> <%= "bg-blue-100 font-semibold" if selected_query == option[:value] %>"
          role="option"
          data-value="<%= option[:value] %>"
          data-label="<%= option[:label] %>"
          data-disabled="<%= option[:disabled] %>"
          data-pg-extras-combobox-option
          <% if option[:disabled] %>aria-disabled="true"<% end %>
        >
          <%= option[:label] %>
          <% if option[:disabled] %>
            <span class="text-xs ml-2">(extension required)</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
