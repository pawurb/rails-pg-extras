<%= content_for :title, params[:query_name].presence || "pg_extras" %>
<%= render "rails_pg_extras/web/shared/queries_selector" %>

<div class="mt-4 mb-4">
  <%= link_to "← Back to Diagnose",
              queries_path(params[:db_key].present? ? { db_key: params[:db_key] } : {}),
              class: "inline-block bg-blue-500 text-white font-medium px-4 py-2 rounded-lg shadow-sm hover:bg-blue-600 transition" %>
</div>

<% if @error %>
  <div class="text-red-500 p-3 font-mono my-5"><%= @error %></div>
<% else %>
  <% if @result&.any? %>
    <%= render "result",
               title: RubyPgExtras.description_for(query_name: @query_name),
               headers: @result[0].keys,
               rows: @result.values %>
  <% else %>
   <div class="font-mono p-3 bg-gray-100 mt-3 rounded-lg">No results</div>
  <% end %>
<% end %>

<style>
@media print {
  form {
    display: none
  }
}
</style>
